{
  "name": "looptroop-website",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing website and published documentation for LoopTroop.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24.x",
    "npm": ">=11.12.1"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "vitepress dev docs --port 5174 --strictPort",
    "docs:build": "vitepress build docs",
    "build": "npm run docs:build && node scripts/build-site.mjs",
    "verify:site": "node scripts/verify-site.mjs && node scripts/sync-cli-reference.mjs --check",
    "sync:cli": "node scripts/sync-cli-reference.mjs",
    "preview": "vitepress preview docs --port 4173 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "mermaid": "^11.16.0",
    "vitepress": "^1.6.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.0": true
  }
}
