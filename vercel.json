{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "site",
  "functions": {
    "api/project-stats.js": {
      "maxDuration": 20
    },
    "api/project-stats-history.js": {
      "maxDuration": 20
    },
    "api/cron/project-stats.js": {
      "maxDuration": 20
    }
  },
  "crons": [
    {
      "path": "/api/cron/project-stats",
      "schedule": "5 * * * *"
    }
  ],
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/install",
      "destination": "https://github.com/looptroop-ai/LoopTroop/releases/latest/download/install.sh",
      "permanent": false
    },
    {
      "source": "/install.sh",
      "destination": "https://github.com/looptroop-ai/LoopTroop/releases/latest/download/install.sh",
      "permanent": false
    },
    {
      "source": "/install.ps1",
      "destination": "https://github.com/looptroop-ai/LoopTroop/releases/latest/download/install.ps1",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/docs/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "max-age=31536000, immutable"
        }
      ]
    }
  ]
}
